# Mizan on AWS Lambda.
#
# This is a second Dockerfile. The other one (Dockerfile) is unchanged and
# still serves Render and local docker compose.
#
# How this works: the Lambda Web Adapter runs as a Lambda extension and acts as
# the Runtime Interface Client, forwarding each invocation to a normal web
# server over localhost. gunicorn therefore runs unmodified, exactly as it does
# in the other image. No application code changes.
#
# Three things here are load-bearing and were each wrong once:
#
# 1. ENTRYPOINT, not CMD. AWS managed base images ship an ENTRYPOINT of
#    /lambda-entrypoint.sh which requires exactly one argument and then starts
#    the Python runtime. A multi-argument CMD makes it exit 142 with
#    "entrypoint requires the handler name to be the first argument". The
#    adapter replaces the runtime, so that entrypoint must be overridden.
#
# 2. No AWS_LAMBDA_EXEC_WRAPPER. That variable and its /opt/bootstrap path
#    belong to the Zip packaging flow. The adapter image contains only
#    /lambda-adapter, so /opt/bootstrap does not exist and setting it makes the
#    runtime exit 127. The adapter supplies the Runtime Interface Client itself.
#
# 3. The image is pushed with --provenance=false --sbom=false. Docker's default
#    buildx output wraps the image in an OCI index, and Lambda rejects an index
#    with "the image manifest, config or layer media type is not supported".
#    deploy.sh passes those flags.

FROM public.ecr.aws/lambda/python:3.11

# The adapter, dropped in as a Lambda extension.
COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.8.4 \
     /lambda-adapter /opt/extensions/lambda-adapter

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

WORKDIR ${LAMBDA_TASK_ROOT}

# Dependencies first, so editing server.py does not invalidate this layer.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY server.py index.html ./

# One worker with threads, not two workers: Lambda scales by running more
# functions, not by adding workers inside one, so extra workers only consume
# memory. The 25 second gunicorn timeout sits under the function's 30 second
# limit so gunicorn reports the failure rather than being killed mid-response.
ENTRYPOINT ["gunicorn", "server:app", "--bind", "0.0.0.0:8080", "--workers", "1", "--threads", "4", "--timeout", "25"]
